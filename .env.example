# Server-only promo codes inserted into special-offer emails.
# Leave empty (or unset) to send the email without a code section.
PROMO_CODE_COMEBACK=
PROMO_CODE_WELCOME=

# Upstash Redis REST (rate limiting). Any one complete pair is enough.
# The Vercel Upstash integration sets the *_KV_REST_API_* / KV_REST_API_* names.
# Read-only tokens are ignored. KV_URL and REDIS_URL are not used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_REST_KV_REST_API_URL=
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Starter intro offer. Empty (or unset) turns the offer off: the upsell shows
# Starter at £5 and ?offer=first3 is ignored. When set, the value is a Stripe
# coupon id (amount_off 200, currency gbp, duration once) — never a price.
# Set it in Vercel → Project → Settings → Environment Variables.
STRIPE_COUPON_STARTER_FIRST_MONTH=
