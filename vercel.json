{
  "functions": {
    "src/app/api/st-packs/**": {
      "memory": 3009
    }
  },
  "crons": [
    {
      "path": "/api/cron/analyze",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/emails",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/daily-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 10 * * 0"
    },
    {
      "path": "/api/cron/lifetime-credits",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/relaunch",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/reconcile-costs",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/dungeon-prizes",
      "schedule": "10 0 * * 1"
    },
    {
      "path": "/api/cron/health",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sprite-lab.vercel.app"
        }
      ],
      "destination": "https://www.sprite-lab.com/:path*",
      "permanent": true
    }
  ]
}
